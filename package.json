{
  "name": "nikke-synchro-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "collect": "node --use-env-proxy scripts/collect.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "highs": "1.15.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.7",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24"
  }
}